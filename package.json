{
  "name": "scenox-vault",
  "private": true,
  "version": "1.0.0",
  "description": "Scenox Vault — self-hosted high-speed client data intake platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:proxy": "node scripts/dev-proxy.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @scenox/api db:migrate",
    "db:generate": "pnpm --filter @scenox/api db:generate",
    "db:seed": "pnpm --filter @scenox/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
