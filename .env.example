# ════════════════════════════════════════════════════════════════════════════
#  Scenox Vault — environment configuration
#  Copy to .env and edit:   cp .env.example .env
#  NEVER commit .env. Generate secrets with:   openssl rand -hex 32
# ════════════════════════════════════════════════════════════════════════════

# ─────────────── Production (docker compose) ───────────────
# Public hostnames. Both must have DNS A/AAAA records pointing at this server.
# Single-domain mode: set UPLOAD_DOMAIN to the same value as APP_DOMAIN and leave UPLOAD_HOST empty.
APP_DOMAIN=app.example.com
UPLOAD_DOMAIN=upload.example.com
# Account e-mail for Let's Encrypt / ZeroSSL certificates (expiry notices only).
ACME_EMAIL=admin@example.com

# The web app returns 404 for admin pages on this host (the client-facing upload domain).
# Set to the same value as UPLOAD_DOMAIN. Leave EMPTY in single-domain mode.
UPLOAD_HOST=upload.example.com
# Where the Next.js server reaches the API inside the compose network (baked at image build time too).
API_INTERNAL_URL=http://api:4000

# PostgreSQL container. In production compose derives DATABASE_URL from these.
# Use hex/alphanumeric passwords (they are embedded in a URL):   openssl rand -hex 24
POSTGRES_USER=scenox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=scenox
# ~25% of RAM dedicated to Postgres, max
# POSTGRES_SHARED_BUFFERS=256MB
# REDIS_MAXMEMORY=256mb
# image tag suffix
# VAULT_VERSION=latest

# ─────────────── API: core ───────────────
# compose forces "production"; use "development" for local pnpm dev
NODE_ENV=production
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000

# In production compose overrides DATABASE_URL, REDIS_URL, STORAGE_PATH, APP_URL, UPLOAD_URL and CLAMAV_HOST.
# The values below are what `pnpm dev` (local development) uses with docker-compose.dev.yml.
DATABASE_URL=postgres://scenox:scenox@localhost:5432/scenox
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379

# Origins as seen by browsers. In production they are derived from APP_DOMAIN / UPLOAD_DOMAIN.
APP_URL=http://localhost:8080
UPLOAD_URL=http://localhost:8080
# Extra allowed CORS / CSRF origins (comma separated). APP_URL and UPLOAD_URL are always allowed.
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the API (Caddy = 1). Wrong value => wrong client IPs.
TRUST_PROXY=1

# Run Drizzle migrations automatically when the API starts. Set to "false" to run them manually
# (docker compose run --rm api node dist/db/migrate.js).
MIGRATE_ON_START=true

# ─────────────── Secrets (REQUIRED — generate your own) ───────────────
# Placeholder is deliberately too short: the API refuses to start until you replace it.
# Signs/keys session + portal tokens (HMAC-SHA256). >= 32 chars:   openssl rand -hex 32
# Rotating it logs everyone out and invalidates all portal links.
SESSION_SECRET=CHANGE_ME
# 32-byte key (64 hex chars) for AES-256-GCM encryption of portal tokens:   openssl rand -hex 32
# LOSING IT makes existing portal links impossible to re-display (they keep working for clients).
ENCRYPTION_KEY=CHANGE_ME
# Force the Secure flag on cookies. Default: true when APP_URL is https.
# COOKIE_SECURE=true

# ─────────────── Storage ───────────────
# only "local" today (S3-compatible planned)
STORAGE_DRIVER=local
# Compose mounts the upload_data volume at /data/storage. tus/ and uploads/ MUST share one filesystem.
STORAGE_PATH=./.data/storage

# ─────────────── Upload engine ───────────────
# Sizes accept raw bytes or 500MB / 50GB / 1.5TB. Empty or 0 = unlimited.
MAX_FILE_SIZE=0
MAX_PORTAL_SIZE=0
# parallel files per browser (1-16); adaptive down on errors
MAX_CONCURRENT_UPLOADS=4
# starting tus chunk size
DEFAULT_CHUNK_SIZE=64MB
# keep <= 95MB when behind Cloudflare's proxy (free plan = 100MB body limit)
MAX_CHUNK_SIZE=256MB
MIN_CHUNK_SIZE=8MB
# per chunk, exponential backoff 0.5s -> 16s
RETRY_COUNT=6
# ms; idle socket timeout on the API for upload requests
UPLOAD_TIMEOUT=600000
# public path of the tus endpoint
TUS_PATH=/api/tus

# ─────────────── E-mail (optional; leave SMTP_HOST empty to disable) ───────────────
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS when offered
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Scenox Vault <no-reply@example.com>"

# ─────────────── Virus scanning (optional) ───────────────
# 1) docker compose --profile clamav up -d   2) set CLAMAV_ENABLED=true   3) docker compose up -d
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─────────────── Misc ───────────────
# per-route Redis limits (login, portal unlock, ...). Keep true in production.
RATE_LIMIT_ENABLED=true
# parallel background jobs (checksums, scans, ZIPs). Disk/CPU bound.
WORKER_CONCURRENCY=2
# Webhooks (Settings -> Developers): deliveries to private/loopback/link-local addresses are
# refused (SSRF protection). Set true ONLY in development to hit a receiver on localhost.
WEBHOOK_ALLOW_PRIVATE=false

# ─────────────── Tests only ───────────────
# TEST_DATABASE_URL=postgres://scenox:scenox@localhost:5432/scenox_test
